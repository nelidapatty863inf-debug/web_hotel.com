/**
 * MEJORAS VISUALES Y FUNCIONALES
 */

document.addEventListener('DOMContentLoaded', function() {
    
    // =====================================================
    // 1. PRELOADER
    // =====================================================
    const preloader = document.createElement('div');
    preloader.className = 'preloader';
    preloader.innerHTML = '<div class="spinner"></div>';
    document.body.appendChild(preloader);
    
    window.addEventListener('load', function() {
        setTimeout(() => {
            preloader.classList.add('hide');
            setTimeout(() => preloader.remove(), 500);
        }, 500);
    });
    
    // =====================================================
    // 2. PROGRESS BAR
    // =====================================================
    const progressBar = document.createElement('div');
    progressBar.className = 'progress-bar';
    document.body.appendChild(progressBar);
    
    window.addEventListener('scroll', () => {
        const scrollTop = window.pageYOffset;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const width = (scrollTop / height) * 100;
        progressBar.style.width = width + '%';
    });
    
    // =====================================================
    // 3. CARRITO FLOTANTE
    // =====================================================
    function addFloatingCart() {
        fetch('api/get_cart_count.php')
            .then(response => response.json())
            .then(data => {
                if (data.count > 0) {
                    let floatingCart = document.querySelector('.cart-floating');
                    if (!floatingCart) {
                        floatingCart = document.createElement('a');
                        floatingCart.className = 'cart-floating';
                        floatingCart.href = 'cart.php';
                        floatingCart.innerHTML = `
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count">${data.count}</span>
                        `;
                        document.body.appendChild(floatingCart);
                    } else {
                        const countSpan = floatingCart.querySelector('.cart-count');
                        if (countSpan) countSpan.textContent = data.count;
                    }
                }
            });
    }
    addFloatingCart();
    
    // =====================================================
    // 4. DARK MODE
    // =====================================================
    const darkModeToggle = document.createElement('div');
    darkModeToggle.className = 'dark-mode-toggle';
    darkModeToggle.innerHTML = '<i class="fas fa-moon"></i>';
    document.body.appendChild(darkModeToggle);
    
    const darkMode = localStorage.getItem('darkMode') === 'true';
    if (darkMode) {
        document.body.classList.add('dark-mode');
        darkModeToggle.innerHTML = '<i class="fas fa-sun"></i>';
    }
    
    darkModeToggle.addEventListener('click', () => {
        document.body.classList.toggle('dark-mode');
        const isDark = document.body.classList.contains('dark-mode');
        localStorage.setItem('darkMode', isDark);
        darkModeToggle.innerHTML = isDark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
    });
    
    // =====================================================
    // 5. SCROLL ANIMATIONS
    // =====================================================
    const animatedElements = document.querySelectorAll('.room-card, .amenity, .testimonial-card');
    animatedElements.forEach(el => el.classList.add('scroll-animate'));
    
    function checkScroll() {
        const elements = document.querySelectorAll('.scroll-animate');
        const windowHeight = window.innerHeight;
        
        elements.forEach(el => {
            const rect = el.getBoundingClientRect();
            if (rect.top < windowHeight - 100) {
                el.classList.add('visible');
            }
        });
    }
    
    window.addEventListener('scroll', checkScroll);
    checkScroll();
    
    // =====================================================
    // 6. TOAST NOTIFICATIONS
    // =====================================================
    window.showToast = function(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `toast-notification ${type}`;
        toast.innerHTML = `
            <i class="fas ${type === 'success' ? 'fa-check-circle' : (type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle')}"></i>
            ${message}
        `;
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.style.animation = 'slideInRight 0.3s reverse';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    };
    
    // =====================================================
    // 7. MODAL SYSTEM
    // =====================================================
    window.showModal = function(title, content) {
        let modal = document.querySelector('.modal');
        
        if (!modal) {
            modal = document.createElement('div');
            modal.className = 'modal';
            modal.innerHTML = `
                <div class="modal-content">
                    <div class="modal-header">
                        <h3></h3>
                        <span class="modal-close">&times;</span>
                    </div>
                    <div class="modal-body"></div>
                </div>
            `;
            document.body.appendChild(modal);
            
            modal.querySelector('.modal-close').addEventListener('click', () => {
                modal.classList.remove('active');
            });
            
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.remove('active');
            });
        }
        
        modal.querySelector('.modal-header h3').textContent = title;
        modal.querySelector('.modal-body').innerHTML = content;
        modal.classList.add('active');
    };
    
    // =====================================================
    // 8. GALERÍA DE IMÁGENES EN DETALLE DE HABITACIÓN
    // =====================================================
    function initRoomGallery() {
        const galleryContainer = document.querySelector('.room-gallery');
        if (!galleryContainer) return;
        
        const images = [
            'https://placehold.co/600x400/3498db/white?text=Habitacion+1',
            'https://placehold.co/600x400/2ecc71/white?text=Habitacion+2',
            'https://placehold.co/600x400/e74c3c/white?text=Habitacion+3',
            'https://placehold.co/600x400/f39c12/white?text=Habitacion+4'
        ];
        
        images.forEach((src, index) => {
            const img = document.createElement('img');
            img.src = src;
            img.alt = `Imagen ${index + 1}`;
            const div = document.createElement('div');
            div.className = 'gallery-item';
            div.appendChild(img);
            div.addEventListener('click', () => {
                showModal('Galería', `<img src="${src}" style="width:100%; border-radius:8px;">`);
            });
            galleryContainer.appendChild(div);
        });
    }
    initRoomGallery();
    
    // =====================================================
    // 9. LAZY LOADING DE IMÁGENES
    // =====================================================
    const images = document.querySelectorAll('img');
    const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const img = entry.target;
                const src = img.dataset.src;
                if (src) {
                    img.src = src;
                }
                observer.unobserve(img);
            }
        });
    });
    
    images.forEach(img => {
        if (!img.src || img.src === '') {
            const originalSrc = img.getAttribute('src');
            if (originalSrc) {
                img.dataset.src = originalSrc;
                img.src = '';
                imageObserver.observe(img);
            }
        }
    });
    
    // =====================================================
    // 10. FILTRO DE HABITACIONES EN TIEMPO REAL
    // =====================================================
    function initRoomFilter() {
        const filterInput = document.createElement('input');
        filterInput.type = 'text';
        filterInput.placeholder = '🔍 Buscar habitación...';
        filterInput.className = 'room-filter';
        filterInput.style.cssText = `
            width: 100%;
            padding: 10px;
            margin: 1rem 0;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
        `;
        
        const roomsSection = document.querySelector('.rooms-section');
        if (roomsSection) {
            const container = roomsSection.querySelector('.container');
            if (container && !container.querySelector('.room-filter')) {
                container.insertBefore(filterInput, container.querySelector('.rooms-grid'));
                
                filterInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const roomCards = document.querySelectorAll('.room-card');
                    
                    roomCards.forEach(card => {
                        const title = card.querySelector('h3')?.textContent.toLowerCase() || '';
                        const description = card.querySelector('p')?.textContent.toLowerCase() || '';
                        
                        if (title.includes(searchTerm) || description.includes(searchTerm)) {
                            card.style.display = '';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            }
        }
    }
    initRoomFilter();
});

