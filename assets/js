// =====================================================
// FUNCIÓN PARA APLICAR CUPÓN
// =====================================================
function applyCoupon() {
    const couponCode = document.getElementById('coupon_code').value;
    if (!couponCode) {
        showNotification('Ingresa un código de cupón', 'warning');
        return;
    }
    
    fetch('api/apply_coupon.php', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `coupon=${encodeURIComponent(couponCode)}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification('Cupón aplicado correctamente', 'success');
            location.reload();
        } else {
            showNotification(data.message || 'Cupón inválido', 'error');
        }
    });
}
/**
 * SCRIPT PARA EL PANEL DE ADMINISTRACIÓN
 * Funcionalidades: gráficas, tablas dinámicas, filtros, etc.
 */

document.addEventListener('DOMContentLoaded', function() {
    
    // =====================================================
    // CONFIRMAR ELIMINACIÓN
    // =====================================================
    window.confirmDelete = function(url, message) {
        if (confirm(message || '¿Estás seguro de eliminar este registro? Esta acción no se puede deshacer.')) {
            window.location.href = url;
        }
    };
    
    // =====================================================
    // FILTRADO DE TABLAS
    // =====================================================
    function initTableFilter() {
        const searchInput = document.getElementById('tableSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function() {
                const filter = this.value.toLowerCase();
                const table = document.querySelector('.data-table');
                if (!table) return;
                
                const rows = table.querySelectorAll('tbody tr');
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(filter) ? '' : 'none';
                });
            });
        }
    }
    initTableFilter();
    
    // =====================================================
    // DASHBOARD - GRÁFICAS
    // =====================================================
    if (document.getElementById('revenueChart')) {
        // Cargar datos para gráficas
        fetch('dashboard_data.php')
            .then(response => response.json())
            .then(data => {
                createRevenueChart(data);
                createOccupancyChart(data);
            });
    }
    
    function createRevenueChart(data) {
        // Aquí puedes integrar Chart.js si lo deseas
        console.log('Revenue data:', data);
    }
    
    function createOccupancyChart(data) {
        console.log('Occupancy data:', data);
    }
    
    // =====================================================
    // CALENDARIO DE DISPONIBILIDAD
    // =====================================================
    function initAvailabilityCalendar() {
        const prevBtn = document.getElementById('prevMonth');
        const nextBtn = document.getElementById('nextMonth');
        let currentDate = new Date();
        
        function loadCalendar(year, month) {
            fetch(`availability_data.php?year=${year}&month=${month}`)
                .then(response => response.json())
                .then(data => {
                    renderCalendar(data);
                });
        }
        
        function renderCalendar(data) {
            const container = document.getElementById('calendarContainer');
            if (!container) return;
            
            let html = '<div class="calendar-grid">';
            html += '<div class="calendar-header">';
            html += '<div>Habitación</div>';
            
            // Días del mes
            for (let i = 1; i <= data.daysInMonth; i++) {
                html += `<div>${i}</div>`;
            }
            html += '</div>';
            
            // Filas por habitación
            data.rooms.forEach(room => {
                html += '<div class="calendar-row">';
                html += `<div class="room-name-cell">${room.name}</div>`;
                
                for (let i = 1; i <= data.daysInMonth; i++) {
                    const dateKey = `${data.year}-${String(data.month).padStart(2,'0')}-${String(i).padStart(2,'0')}`;
                    const availability = room.availability[dateKey];
                    let cellClass = 'available-cell';
                    let cellText = availability || '0';
                    
                    if (availability === 0) cellClass = 'unavailable-cell';
                    if (room.blockedDates && room.blockedDates.includes(dateKey)) cellClass = 'blocked-cell';
                    
                    html += `<div class="${cellClass}" data-date="${dateKey}" data-room="${room.id}">
                                ${cellText}
                             </div>`;
                }
                html += '</div>';
            });
            html += '</div>';
            
            container.innerHTML = html;
            
            // Agregar evento de clic para editar disponibilidad
            document.querySelectorAll('.calendar-row [data-date]').forEach(cell => {
                cell.addEventListener('click', function(e) {
                    const roomId = this.dataset.room;
                    const date = this.dataset.date;
                    const currentValue = this.textContent;
                    
                    const newValue = prompt('Disponibilidad (número de habitaciones):', currentValue);
                    if (newValue !== null && !isNaN(newValue) && newValue >= 0) {
                        updateAvailability(roomId, date, newValue);
                    }
                });
            });
        }
        
        function updateAvailability(roomId, date, units) {
            fetch('availability_update.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `room_id=${roomId}&date=${date}&units=${units}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error al actualizar disponibilidad');
                }
            });
        }
        
        if (prevBtn && nextBtn && currentDate) {
            prevBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                loadCalendar(currentDate.getFullYear(), currentDate.getMonth() + 1);
            });
            
            nextBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                loadCalendar(currentDate.getFullYear(), currentDate.getMonth() + 1);
            });
            
            loadCalendar(currentDate.getFullYear(), currentDate.getMonth() + 1);
        }
    }
    initAvailabilityCalendar();
    
    // =====================================================
    // EXPORTAR DATOS
    // =====================================================
    window.exportData = function(type, format = 'csv') {
        const url = `export_data.php?type=${type}&format=${format}`;
        window.open(url, '_blank');
    };
    
    // =====================================================
    // CAMBIO DE ESTADO DE RESERVA
    // =====================================================
    window.updateReservationStatus = function(reservationId, status) {
        fetch('reservation_update.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `id=${reservationId}&status=${status}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error al actualizar el estado');
            }
        });
    };
    
    // =====================================================
    // VISTA PREVIA DE IMAGEN
    // =====================================================
    const imageInput = document.getElementById('roomImage');
    if (imageInput) {
        imageInput.addEventListener('change', function(e) {
            const preview = document.getElementById('imagePreview');
            if (preview && this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
    }
    
    // =====================================================
    // VALIDACIÓN DE FORMULARIOS DEL ADMIN
    // =====================================================
    const adminForms = document.querySelectorAll('.admin-form');
    adminForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            const priceInput = form.querySelector('input[name="price_per_night"], input[name="total_amount"]');
            if (priceInput && priceInput.value && isNaN(parseFloat(priceInput.value))) {
                e.preventDefault();
                alert('El precio debe ser un número válido');
                priceInput.focus();
            }
            
            const emailInput = form.querySelector('input[type="email"]');
            if (emailInput && emailInput.value && !isValidEmail(emailInput.value)) {
                e.preventDefault();
                alert('Ingresa un correo electrónico válido');
                emailInput.focus();
            }
        });
    });
    
    function isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }
    
    // =====================================================
    // TOOLTIP PARA ADMIN
    // =====================================================
    const adminTooltips = document.querySelectorAll('[data-tooltip]');
    adminTooltips.forEach(el => {
        el.addEventListener('mouseenter', function(e) {
            const tooltip = document.createElement('div');
            tooltip.className = 'admin-tooltip';
            tooltip.textContent = this.dataset.tooltip;
            tooltip.style.cssText = `
                position: absolute;
                background: #2c3e50;
                color: white;
                padding: 5px 10px;
                border-radius: 5px;
                font-size: 12px;
                z-index: 1000;
            `;
            document.body.appendChild(tooltip);
            
            const rect = this.getBoundingClientRect();
            tooltip.style.top = rect.top - tooltip.offsetHeight - 5 + 'px';
            tooltip.style.left = rect.left + (rect.width / 2) - (tooltip.offsetWidth / 2) + 'px';
            
            this.addEventListener('mouseleave', () => tooltip.remove(), { once: true });
        });
    });
});

